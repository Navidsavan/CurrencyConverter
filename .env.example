# ─── NestJS backend (backend-nestjs/) ────────────────────────────────
# FREECURRENCY_API_KEY: key for FreeCurrencyAPI. Read on the server only —
# it is never sent to the browser.
FREECURRENCY_API_KEY="4E0VK7BnkdeUuh1vegAt808v2IUjzUR6lxcvBMT2"

# PORT: port the backend listens on. Hosting providers set this themselves.
PORT="4000"

# CORS_ORIGIN: comma-separated list of frontends allowed to call the API.
# Leave unset locally; set it to your deployed frontend URL in production.
# CORS_ORIGIN="https://your-app.vercel.app"

# ─── Next.js frontend ────────────────────────────────────────────────
# Where the browser reaches the NestJS backend. A URL, not a secret.
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined at BUILD time. When you change
# this on Vercel you must redeploy — setting the variable alone does nothing
# to an existing build. In production this must be a public https:// URL;
# localhost only ever resolves to the visitor's own device.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"
