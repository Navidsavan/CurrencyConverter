# ─── Required ────────────────────────────────────────────────────────
# FREECURRENCY_API_KEY: key for FreeCurrencyAPI. Read on the server only —
# it is never sent to the browser. This is the only variable a Vercel
# deployment needs.
FREECURRENCY_API_KEY="4E0VK7BnkdeUuh1vegAt808v2IUjzUR6lxcvBMT2"

# ─── Optional ────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_BASE_URL: where the browser reaches the API.
#
# Leave it unset. The NestJS app is mounted inside the Next.js server at
# /api, so the default same-origin '/api' works both locally and when
# deployed — one host, no CORS.
#
# Set it only to point the client at a separately hosted backend, such as
# the standalone NestJS server:
# NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"
#
# Note that NEXT_PUBLIC_* values are inlined at BUILD time, so changing this
# requires a rebuild. It must never be a localhost URL in a deployed build —
# localhost resolves to the visitor's own device, so the site would work on
# your machine and fail on every phone.

# PORT: port for the standalone NestJS server (defaults to 4000).
PORT="4000"

# CORS_ORIGIN: comma-separated allowlist, used only by the standalone server.
# Unnecessary when the API is served from the same origin as the UI.
# CORS_ORIGIN="https://your-app.vercel.app"
